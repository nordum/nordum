{{#> layout pageTitle="Language Rules - Nordum" currentPage="rules" bodyClass="rules-page"}}

<div class="page-header">
    <div class="container">
        <h1>{{t "rules.title" "Language Rules"}}</h1>
        <p class="lead">{{t "rules.subtitle" "Core principles that make Nordum easy to learn and use in today's multilingual world"}}</p>

        <div class="quick-links">
            <a href="/rules/language-specification.html" class="btn btn-primary">
                {{t "rules.full_specification" "Complete Language Specification"}}
            </a>
            <a href="/rules/dictionary-import/" class="btn btn-outline">
                {{t "rules.dictionary_import" "Dictionary Import System"}}
            </a>
        </div>
    </div>
</div>

<div class="main-content">
    <div class="container">
        <div class="overview-section">
            <h2>{{t "rules.overview.title" "Language Overview"}}</h2>
            <p>{{t "rules.overview.description" "Nordum is a constructed pan-Scandinavian written language designed to maximize mutual intelligibility between Norwegian (Bokmål), Danish, and Swedish while maintaining systematic regularity and practical modern usage. It respects all three source languages equally and provides balanced linguistic solutions."}}</p>

            <div class="key-features">
                <div class="feature-card">
                    <h3>{{t "rules.features.balanced" "Balanced Pan-Scandinavian"}}</h3>
                    <p>{{t "rules.features.balanced_desc" "Equal respect for Norwegian, Danish, and Swedish with strategic selection"}}</p>
                </div>
                <div class="feature-card">
                    <h3>{{t "rules.features.systematic" "Systematic Grammar"}}</h3>
                    <p>{{t "rules.features.systematic_desc" "Clear grammatical distinctions through distinctive endings"}}</p>
                </div>
                <div class="feature-card">
                    <h3>{{t "rules.features.modern" "Modern Integration"}}</h3>
                    <p>{{t "rules.features.modern_desc" "Technical terms and loanwords preserved for practical communication"}}</p>
                </div>
                <div class="feature-card">
                    <h3>{{t "rules.features.flexible" "Alternative Spellings"}}</h3>
                    <p>{{t "rules.features.flexible_desc" "Multiple valid forms accommodate regional pronunciation"}}</p>
                </div>
            </div>
        </div>

        <div class="rules-grid">
</div>
            <!-- Core Philosophy -->
            <section class="rule-section">
                <h2>{{t "rules.philosophy.title" "Core Philosophy"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.philosophy.bokmaal_danish" "Balanced Pan-Scandinavian Selection"}}</h3>
                    <p>{{t "rules.philosophy.bokmaal_danish_desc" "Nordum respects all three source languages equally with strategic selection for optimal clarity. Forms are chosen based on pan-Scandinavian intelligibility optimization, not favoring any single tradition."}}</p>

                    <div class="example-box">
                        <strong>{{t "common.example" "Example"}}:</strong>
                        <ul>
                            <li><strong>{{t "common.languageLabel.norwegian"}}:</strong> arbeider</li>
                            <li><strong>{{t "common.languageLabel.danish"}}:</strong> arbejder</li>
                            <li><strong>{{t "common.languageLabel.swedish"}}:</strong> arbetar</li>
                            <li><strong>{{t "common.languageLabel.nordum"}}:</strong> <span class="nordum-word">arbeider</span> (selected for majority agreement and systematic morphology)</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- English Loanwords -->
            <section class="rule-section">
                <h2>{{t "rules.loanwords.title" "English Loanwords"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.loanwords.unchanged" "Comprehensive Loanword Integration"}}</h3>
                    <p>{{t "rules.loanwords.unchanged_desc" "Modern technical terms from English and other languages remain unchanged, following established Scandinavian practice. This includes technical, digital, and contemporary terms that are widely recognized internationally."}}</p>

                    <div class="example-box">
                        <strong>{{t "common.examples" "Examples"}}:</strong>
                        <div class="word-grid">
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.english"}}:</span>
                                <span class="source-word">computer</span>
                                <span class="nordum-result">→ <span class="nordum-word">computer</span></span>
                            </div>
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.english"}}:</span>
                                <span class="source-word">internet</span>
                                <span class="nordum-result">→ <span class="nordum-word">internet</span></span>
                            </div>
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.english"}}:</span>
                                <span class="source-word">software</span>
                                <span class="nordum-result">→ <span class="nordum-word">software</span></span>
                            </div>
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.english"}}:</span>
                                <span class="source-word">email</span>
                                <span class="nordum-result">→ <span class="nordum-word">email</span></span>
                            </div>
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.german"}}:</span>
                                <span class="source-word">Schokolade</span>
                                <span class="nordum-result">→ <span class="nordum-word">schokolade</span></span>
                            </div>
                            <div class="word-comparison">
                                <span class="source-lang">{{t "common.languageLabel.spanish"}}:</span>
                                <span class="source-word">patio</span>
                                <span class="nordum-result">→ <span class="nordum-word">patio</span></span>
                            </div>
                        </div>
                    </div>

                    <div class="note-box">
                        <strong>{{t "common.note" "Note"}}:</strong> {{t "rules.loanwords.note" "This approach follows established Scandinavian practice for technical terminology, making Nordum immediately practical for modern multilingual communication. Users can choose between loanwords and native Nordum forms."}}
                    </div>
                </div>
            </section>

            <!-- Number System -->
            <section class="rule-section">
                <h2>{{t "rules.numbers.title" "Number System"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.numbers.norwegian" "Regular Number System"}}</h3>
                    <p>{{t "rules.numbers.norwegian_desc" "Nordum adopts the Norwegian number system for maximum regularity and simplicity, eliminating the complex vigesimal system while remaining clear to all Scandinavian speakers."}}</p>

                    <div class="number-table">
                        <h4>{{t "rules.numbers.basic" "Basic Numbers"}}</h4>
                        <div class="number-grid">
                            <div class="number-row"><span class="number">1</span> <span class="nordum-word">en/ett</span></div>
                            <div class="number-row"><span class="number">2</span> <span class="nordum-word">to</span></div>
                            <div class="number-row"><span class="number">3</span> <span class="nordum-word">tre</span></div>
                            <div class="number-row"><span class="number">4</span> <span class="nordum-word">fire</span></div>
                            <div class="number-row"><span class="number">5</span> <span class="nordum-word">fem</span></div>
                            <div class="number-row"><span class="number">10</span> <span class="nordum-word">ti</span></div>
                            <div class="number-row"><span class="number">20</span> <span class="nordum-word">tjue</span></div>
                            <div class="number-row"><span class="number">50</span> <span class="nordum-word">femti</span> <em>(not halvtreds)</em></div>
                            <div class="number-row"><span class="number">100</span> <span class="nordum-word">hundre</span></div>
                            <div class="number-row"><span class="number">1000</span> <span class="nordum-word">tusen</span></div>
                        </div>
                    </div>

                    <div class="comparison-box">
                        <h4>{{t "rules.numbers.comparison" "Why Norwegian?"}}</h4>
                        <table class="comparison-table">
                            <thead>
                                <tr>
                                    <th>{{t "common.number" "Number"}}</th>
                                    <th>{{t "common.norwegian" "Norwegian"}}</th>
                                    <th>{{t "common.danish" "Danish"}}</th>
                                    <th>{{t "common.swedish" "Swedish"}}</th>
                                    <th>{{t "common.nordum" "Nordum"}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>50</td>
                                    <td>femti</td>
                                    <td>halvtreds</td>
                                    <td>femtio</td>
                                    <td><strong>femti</strong></td>
                                </tr>
                                <tr>
                                    <td>60</td>
                                    <td>seksti</td>
                                    <td>tres</td>
                                    <td>sextio</td>
                                    <td><strong>seksti</strong></td>
                                </tr>
                                <tr>
                                    <td>70</td>
                                    <td>sytti</td>
                                    <td>halvfjerds</td>
                                    <td>sjuttio</td>
                                    <td><strong>sytti</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Question Words -->
            <section class="rule-section">
                <h2>{{t "rules.questions.title" "Question Words"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.questions.no_silent_h" "Question Word System"}}</h3>
                    <p>{{t "rules.questions.no_silent_h_desc" "Question words use clear 'v-' patterns with multiple valid forms to accommodate regional pronunciation differences. Silent 'h' is eliminated following systematic phonetic transparency."}}</p>

                    <div class="question-grid">
                        <div class="question-word">
                            <span class="nordum-word">vad/va</span>
                            <span class="english">{{t "questionWords.what"}}</span>
                            <div class="comparison">
                                <small>Alternatives: vad (full), va (short)</small>
                            </div>
                        </div>
                        <div class="question-word">
                            <span class="nordum-word">var/vor</span>
                            <span class="english">{{t "questionWords.where"}}</span>
                            <div class="comparison">
                                <small>Alternatives: var (Swedish), vor (Danish/Norwegian)</small>
                            </div>
                        </div>
                        <div class="question-word">
                            <span class="nordum-word">når/när/ven/vornår</span>
                            <span class="english">{{t "questionWords.when"}}</span>
                            <div class="comparison">
                                <small>Alternatives: når (Norwegian), när (Swedish), ven/vornår (Danish)</small>
                            </div>
                        </div>
                        <div class="question-word">
                            <span class="nordum-word">vem</span>
                            <span class="english">{{t "questionWords.who"}}</span>
                            <div class="comparison">
                                <small>Standard form: vem</small>
                            </div>
                        </div>
                        <div class="question-word">
                            <span class="nordum-word">varför/vorfor</span>
                            <span class="english">{{t "questionWords.why"}}</span>
                            <div class="comparison">
                                <small>Alternatives: varför (Swedish), vorfor (Danish/Norwegian)</small>
                            </div>
                        </div>
                        <div class="question-word">
                            <span class="nordum-word">vilken</span>
                            <span class="english">{{t "questionWords.which"}}</span>
                            <div class="comparison">
                                <small>Standard form: vilken</small>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Phonetic Integration -->
            <section class="rule-section">
                <h2>{{t "rules.phonetics.title" "Phonetic-Based Spelling"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.phonetics.transcription" "Systematic Phonetic Transparency"}}</h3>
                    <p>{{t "rules.phonetics.transcription_desc" "Nordum spelling consistently reflects pronunciation with systematic sound-symbol correspondence. Silent letters are eliminated where possible, and alternative spellings accommodate regional pronunciation differences."}}</p>

                    <div class="phonetic-examples">
                        <div class="phonetic-rule">
                            <h4>{{t "rules.phonetics.vowel_clarity" "Vowel System Flexibility"}}</h4>
                            <p>{{t "rules.phonetics.vowel_clarity_desc" "Nordum supports multiple vowel spelling systems with no grammatical consequences:"}}</p>
                            <ul>
                                <li><strong>Primary:</strong> æ, ø (Norwegian/Danish pattern)</li>
                                <li><strong>Alternative:</strong> ä, ö (Swedish/German pattern)</li>
                                <li><strong>Examples:</strong> hæst/häst, døra/döra, brød/bröd</li>
                            </ul>
                        </div>

                        <div class="phonetic-rule">
                            <h4>{{t "rules.phonetics.consonant_clusters" "Consonant Sound Patterns"}}</h4>
                            <p>{{t "rules.phonetics.consonant_clusters_desc" "Systematic rules for consonant sounds and spelling patterns:"}}</p>
                            <ul>
                                <li><strong>K/J/G rules:</strong> søke/søge → søge, genstand/gjenstand → genstand</li>
                                <li><strong>Native words:</strong> Use "ks" instead of "x" (fiks not fix)</li>
                                <li><strong>Prepositions:</strong> Follow Bokmål pattern (i, på, fra, med, om)</li>
                                <li><strong>Sound patterns:</strong> ej→ei, aj→ei, øj→øi, øy→øi normalization</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Practical Usage -->
            <section class="rule-section">
                <h2>{{t "rules.practical.title" "Modern Usage"}}</h2>
                <div class="principle-card">
                    <h3>{{t "rules.practical.multilingual" "Comprehensive Language System"}}</h3>
                    <p>{{t "rules.practical.multilingual_desc" "Nordum provides a complete linguistic system with systematic morphological distinctions, pronoun standardization, and practical usage patterns that work alongside native Scandinavian languages."}}</p>

                    <div class="usage-tips">
                        <div class="tip-card">
                            <h4>{{t "rules.practical.code_switching" "Systematic Morphology"}}</h4>
                            <p>{{t "rules.practical.code_switching_desc" "Clear grammatical distinctions: verbs always -er, noun plurals usually -ar, comparatives -ere, superlatives -est for immediate parsing."}}</p>
                        </div>

                        <div class="tip-card">
                            <h4>{{t "rules.practical.learning" "Pronoun Standardization"}}</h4>
                            <p>{{t "rules.practical.learning_desc" "Comprehensive pronoun system: jei/mei, du/dei, han/hun, vi/oss, ni/er, de/dem with clear possessive and reflexive forms."}}</p>
                        </div>

                        <div class="tip-card">
                            <h4>{{t "rules.practical.recognition" "Geographic Names"}}</h4>
                            <p>{{t "rules.practical.recognition_desc" "Place names use common endonyms (Argentina, Hellas, España) with limited permitted exonyms (Tyskland, Østerrike) for international recognition."}}</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- Navigation -->
        <nav class="page-navigation">
            <a href="/tools/" class="nav-link">
                {{t "nav.try_tools" "Try the Tools"}} →
            </a>
            <a href="/rules/dictionary-import/" class="nav-link">
                {{t "nav.dictionary_import" "Dictionary Import"}} →
            </a>
        </nav>
    </div>
</div>

<style>
    .rules-grid {
        display: grid;
        gap: 2rem;
        margin: 2rem 0;
    }

    .rule-section {
        background: var(--bg-light);
        border-radius: 12px;
        padding: 2rem;
        border: 1px solid var(--border-color);
    }

    .principle-card {
        margin-top: 1rem;
    }

    .example-box, .note-box, .comparison-box {
        background: var(--bg-secondary);
        padding: 1.5rem;
        border-radius: 8px;
        margin: 1rem 0;
        border-left: 4px solid var(--primary-color);
    }

    .nordum-word {
        color: var(--primary-color);
        font-weight: 600;
        font-size: 1.1em;
    }

    .word-grid {
        display: grid;
        gap: 0.75rem;
        margin-top: 1rem;
    }

    .word-comparison {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.5rem;
        background: white;
        border-radius: 4px;
    }

    .source-lang {
        font-weight: 500;
        color: var(--text-secondary);
        min-width: 70px;
    }

    .source-word {
        font-family: monospace;
        background: var(--bg-code);
        padding: 0.2rem 0.4rem;
        border-radius: 3px;
        min-width: 80px;
    }

    .nordum-result {
        color: var(--primary-color);
        font-weight: 500;
    }

    .number-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 0.5rem;
        margin: 1rem 0;
    }

    .number-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem;
        background: white;
        border-radius: 4px;
    }

    .number {
        font-weight: bold;
        min-width: 30px;
        text-align: center;
    }

    .comparison-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
    }

    .comparison-table th,
    .comparison-table td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
    }

    .comparison-table th {
        background: var(--bg-secondary);
        font-weight: 600;
    }

    .question-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
    }

    .question-word {
        background: white;
        padding: 1rem;
        border-radius: 8px;
        text-align: center;
        border: 2px solid var(--border-color);
    }

    .question-word .nordum-word {
        display: block;
        font-size: 1.3em;
        margin-bottom: 0.5rem;
    }

    .question-word .english {
        display: block;
        color: var(--text-secondary);
        font-style: italic;
        margin-bottom: 0.5rem;
    }

    .question-word .comparison {
        font-size: 0.85em;
        color: var(--text-muted);
    }

    .phonetic-examples {
        display: grid;
        gap: 1.5rem;
        margin-top: 1rem;
    }

    .phonetic-rule {
        background: white;
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .phonetic-rule h4 {
        margin-top: 0;
        color: var(--primary-color);
    }

    .usage-tips {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .tip-card {
        background: white;
        padding: 1.5rem;
        border-radius: 8px;
        border: 1px solid var(--border-color);
    }

    .tip-card h4 {
        margin-top: 0;
        color: var(--primary-color);
    }

    .page-navigation {
        display: flex;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-color);
    }

    .nav-link {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background: var(--primary-color);
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 500;
        transition: background 0.2s;
    }

    .nav-link:hover {
        background: var(--primary-dark);
    }

    @media (max-width: 768px) {
        .word-comparison {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .usage-tips {
            grid-template-columns: 1fr;
        }

        .page-navigation {
            flex-direction: column;
        }
    }
</style>

{{/layout}}
